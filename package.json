{
  "name": "mqtt-monitor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --env-file=.env server/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "build": "tsc -p tsconfig.server.json && tsc -b && vite build",
    "test": "tsx --test tests/*.test.ts",
    "test:telegram": "tsx --env-file=.env server/test-telegram.ts",
    "start": "node dist-server/server/index.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "mqtt": "^5.10.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socks-proxy-agent": "^8.0.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
